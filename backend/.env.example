# ─────────────────────────────────────────────────────────────────
# HeatShield AI – Backend Environment Variables (EXAMPLE)
# Copy this file to .env and fill in real values.
# DO NOT commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────

# Secret key for JWT signing – use a long random string in production
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL database connection URL
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# pgAdmin is the GUI – the app connects directly to PostgreSQL.
# Open-Meteo does NOT require an API key.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/heatshield

# CORS origins – comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model file paths (relative to the project root)
MODEL_PATH=../models/heatwave_model.pkl
PIPELINE_PATH=../models/preprocess.joblib

# Risk thresholds config file path
THRESHOLDS_PATH=../config/risk_thresholds.json

# Background weather data collection interval (minutes)
WEATHER_UPDATE_INTERVAL_MINUTES=15

# Admin user credentials (auto-created on first run)
DEMO_USER_EMAIL=admin@heatshield.ai
DEMO_USER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DEMO_USER_NAME=HeatShield Admin
